rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles: Searchable by name, updatable and deletable after 2 hours
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    // Chats: Direct messages and groups searchable and joinable by name
    match /chats/{chatId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Messages: Realtime messaging in chats
    match /chats/{chatId}/messages/{messageId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Calls: WebRTC signaling for voice calls
    match /calls/{callId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
  }
}
